<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Happy Propose Day Sharmila</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(to bottom right, #ffb6c1, #ffe4e1);
            text-align: center;
            color: #880e4f;
            height: 100vh;
            overflow: hidden;
        }

        .container {
            padding: 40px 20px;
        }

        h1 {
            font-size: 40px;
        }

        h2 {
            font-size: 26px;
        }

        .heart {
            font-size: 80px;
            animation: beat 1s infinite;
        }

        @keyframes beat {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }

        .message {
            font-size: 18px;
            margin: 25px auto;
            max-width: 600px;
            line-height: 1.6;
        }

        .buttons {
            margin-top: 30px;
            position: relative;
            height: 200px;
        }

        button {
            padding: 12px 30px;
            font-size: 18px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
        }

        #yesBtn {
            background-color: #d81b60;
            color: white;
        }

        #noBtn {
            background-color: #757575;
            color: white;
            position: absolute;
        }

        #result {
            margin-top: 30px;
            font-size: 28px;
            color: #c2185b;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="heart">❤️</div>
    <h1>Happy Propose Day</h1>
    <h2>Dear Sharmila</h2>

    <div class="message">
        You make my days brighter and my smiles real.  
        On this Propose Day, I just want to ask one simple question 💖
    </div>

    <h2>Will you be my special one?</h2>

    <div class="buttons">
        <button id="yesBtn" onclick="sayYes()">YES</button>
        <button id="noBtn" onmouseover="moveNo()">NO</button>
    </div>

    <div id="result"></div>
</div>

<script>
    function sayYes() {
        document.getElementById("result").innerHTML = "I love you too ❤️";
    }

    function moveNo() {
        const noBtn = document.getElementById("noBtn");
        const x = Math.random() * (window.innerWidth - 100);
        const y = Math.random() * (window.innerHeight - 100);
        noBtn.style.left = x + "px";
        noBtn.style.top = y + "px";
    }
</script>

</body>
</html>
