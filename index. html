<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Happy Propose Day</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ff5f6d, #ffc371);
            font-family: Arial, sans-serif;
        }

        .card {
            background: rgba(0, 0, 0, 0.35);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            max-width: 380px;
            text-align: center;
            color: white;
        }

        img {
            width: 100%;
            border-radius: 15px;
            margin-bottom: 15px;
        }

        h1 {
            font-size: 26px;
            margin: 10px 0;
        }

        p {
            font-size: 17px;
            line-height: 1.5;
        }

        .buttons {
            margin-top: 15px;
        }

        button {
            padding: 10px 22px;
            margin: 5px;
            border: none;
            border-radius: 25px;
            font-size: 16px;
            cursor: pointer;
        }

        .yes {
            background-color: #ff4d6d;
            color: white;
        }

        .no {
            background-color: #ddd;
            color: black;
        }
    </style>
</head>
<body>

    <!-- 🎵 Hidden Background Music -->
    <audio id="bgMusic" autoplay loop>
        <source src="music.mp3" type="audio/mpeg">
    </audio>

    <div class="card">
        <!-- 🖼️ Proposal Image -->
        <img src="proposal.png" alt="Proposal Image">

        <h1>Happy Propose Day ❤️</h1>

        <p>
            Dear <strong>Sharmila</strong>,<br>
            From the first moment I saw you,<br>
            my heart chose you forever.
        </p>

        <div class="buttons">
            <button class="yes" onclick="alert('She said YES ❤️')">Yes</button>
            <button class="no" onclick="alert('Please think again 💔')">No</button>
        </div>
    </div>

    <!-- 🎯 Mobile autoplay fix -->
    <script>
        document.addEventListener("click", function () {
            const music = document.getElementById("bgMusic");
            music.play();
        }, { once: true });
    </script>

</body>
</html>